# Copy this file to ".env" and fill in your values. Never commit .env to Git.

# ---- AI provider: "gemini" (free, uses the /knowledge folder) or "dify" ----
AI_PROVIDER=gemini

# Free key: https://aistudio.google.com/apikey  (sign in with Google → Create API key)
GEMINI_API_KEY=

# Optional: which Gemini model(s) to use, comma-separated, tried in order.
# Leave empty to use the defaults (gemini-flash-latest, gemini-2.5-flash, ...).
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3-flash-preview,gemini-3.1-flash-lite-preview

# ---- Only needed if AI_PROVIDER=dify ----
DIFY_API_KEY=
DIFY_API_BASE=https://api.dify.ai/v1

# ---- Server ----
PORT=3000
# Comma-separated list of sites allowed to call the API (empty = allow all)
ALLOWED_ORIGINS=
# Max chat messages per visitor IP per minute
RATE_LIMIT_PER_MIN=20
